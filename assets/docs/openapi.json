ription":"物流公司筛选","title":"Logistics"},"description":"物流公司筛选"},{"name":"customer_name","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"客户名称筛选(包含匹配)","title":"Customer Name"},"description":"客户名称筛选(包含匹配)"},{"name":"upload_type","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"上传业务类型筛选","title":"Upload Type"},"description":"上传业务类型筛选"},{"name":"include_excel","in":"query","required":false,"schema":{"type":"boolean","description":"是否包含Excel数据","default":true,"title":"Include Excel"},"description":"是否包含Excel数据"},{"name":"include_images","in":"query","required":false,"schema":{"type":"boolean","description":"是否包含图片文件","default":true,"title":"Include Images"},"description":"是否包含图片文件"},{"name":"include_doc_number","in":"query","required":false,"schema":{"type":"boolean","description":"导出图片时是否在左上角叠加单据编号","default":true,"title":"Include Doc Number"},"description":"导出图片时是否在左上角叠加单据编号"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/admin/statistics":{"get":{"tags":["admin"],"summary":"Get Statistics","description":"获取统计数据\n\n响应格式:\n{\n    \"total_uploads\": 1500,\n    \"pending_count\": 10,\n    \"uploading_count\": 5,\n    \"success_count\": 1450,\n    \"failed_count\": 35,\n    \"by_doc_type\": {\n        \"销售\": 800,\n        \"转库\": 600,\n        \"其他\": 100\n    }\n}","operationId":"get_statistics_api_admin_statistics_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Get Statistics Api Admin Statistics Get"}}}}}}},"/api/admin/records/{record_id}/check":{"patch":{"tags":["admin"],"summary":"Update Check Status","description":"更新记录的检查状态\n\n路径参数:\n- record_id: 记录ID\n\n请